NEON_DATABASE_URL=
AUCTIONS_API_KEY=
# AUCTIONS_API_BASE_URL: optional override of the AuctionsAPI base URL used by the
#   VIN-report lookups (default "https://auctionsapi.com/api").
AUCTIONS_API_BASE_URL=
# Optional site URLs. NEXT_PUBLIC_SITE_URL is the canonical origin for metadata,
# sitemaps and IndexNow (default "https://www.selectauto.bg");
# NEXT_PUBLIC_APP_URL is the fallback for APP_URL below in email links.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# AWS + Pulumi — auto-loaded into the infra deploy/preview/destroy scripts via
# dotenv-cli (infra/package.json runs `dotenv -e ../.env -- pulumi ...`).
# AWS_PROFILE: your `aws configure sso` profile name (deploys target that account).
# PULUMI_CONFIG_PASSPHRASE: unlocks the encrypted Pulumi stack secrets.
# You still run `aws sso login` when the SSO token expires (auth refresh).
AWS_PROFILE=
PULUMI_CONFIG_PASSPHRASE=

# Auth.js (NextAuth v5) — self-hosted Google OAuth + email/password, JWT sessions.
# AUTH_SECRET signs the session JWT (generate one with `npx auth secret`).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET come from the Google OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Base URL used to build the links in auth emails (verify email / reset password).
# REQUIRED for local dev: without it the links fall back to the production domain
# (https://selectauto.bg), so you can't complete verification/reset against a local
# server. e.g. http://localhost:3000
APP_URL=

# Resend — the site's transactional mail (lead notifications, offers, auth links).
# RESEND_API_KEY is required to send; CARFAX_NOTIFY_EMAIL overrides the
# recipient of lead notifications (defaults to info@selectauto.bg). RESEND_FROM
# overrides the sender (default "SelectAuto <noreply@selectauto.bg>"); it must be
# on a Resend-verified domain.
RESEND_API_KEY=""
CARFAX_NOTIFY_EMAIL=
RESEND_FROM=

# Resend INBOUND — the apex MX for selectauto.bg points at Resend's receiving
# endpoint, so mail to ANY @selectauto.bg address (incl. the published
# info@selectauto.bg) is accepted by Resend. There is no mailbox behind it
# (receiving has no IMAP/POP): /api/resend-inbound stores each message in the
# admin inbox (/admin/poshta), where it is answered, and can forward a copy.
# RESEND_WEBHOOK_SECRET: signing secret of the `email.received` webhook endpoint
#   (Resend dashboard → Webhooks). REQUIRED — the route fails closed with 503
#   without it, since an unverified payload must never be acted on.
# MAIL_FORWARD_TO: destination mailbox. Unset ⇒ nothing is forwarded.
# MAIL_FORWARD_ADDRESSES: comma-separated allowlist of recipient addresses worth
#   forwarding. Unset OR empty ⇒ the safe default ("info@selectauto.bg"); the
#   literal "*" ⇒ forward the whole catch-all. The MX accepts EVERY address at the
#   domain, so relaying it all turns the destination inbox into a spam trap and
#   drains the quota — inbound and outbound share one Resend limit.
# MAIL_FORWARD_FROM: sender of the forwarded copy; must be on the Resend-verified
#   domain (default "SelectAuto <info@selectauto.bg>"). Kept separate from the
#   noreply@ transactional sender.
# MAIL_REPLY_FROM: sender for admin-panel REPLIES (default "info@selectauto.bg").
#   Kept separate from the noreply@ transactional sender on purpose — a customer
#   replying to a human must not be answering a no-reply address.
RESEND_WEBHOOK_SECRET=
MAIL_FORWARD_TO=
MAIL_FORWARD_ADDRESSES=
MAIL_FORWARD_FROM=
MAIL_REPLY_FROM=
# MAIL_IGNORE_SENDERS: comma-separated senders that are FORWARDED but never filed
#   as a conversation (default "noreply@selectauto.bg"). The app mails its own
#   lead notifications from noreply@ to info@, and because the apex MX is Resend
#   receiving they come straight back as "inbound" — 60 of the first 78 stored
#   messages were the app talking to itself. Those leads already have their own
#   inboxes (/admin/carfax etc.), so filing them again would bury real customer
#   mail.
MAIL_IGNORE_SENDERS=

# IndexNow — instant "this URL was deleted" pings for the paid de-listing
# (/admin/skriti-obyavi). 8-128 hex characters; generate any random hex string.
# Ownership is proved by serving {key}.txt at the SITE ROOT, which next.config.ts
# rewrites onto /api/indexnow-key — so ROTATING THE KEY NEEDS A REDEPLOY (the
# rewrite is built from this value). Unset ⇒ submission is skipped and the
# de-listing still works; only the Bing/Yandex/Naver notification is lost.
# NOTE: Google does NOT participate in IndexNow and has no URL-removal API at
# all — the Google side stays a manual Search Console request.
INDEXNOW_KEY=

# Vercel Cron — secures every cron route (apps/web/vercel.json): the daily
# "любими автомобили с търг днес" digest, the daily overdue-payments sweep, the
# hourly mail reconcile and the 15-minute de-index sweep. Vercel automatically
# sends this value as the `Authorization: Bearer <CRON_SECRET>` header when it
# invokes a cron path; each route rejects anything that doesn't match (and fails
# closed with 401 if it's unset). Use a random string of at least 16 characters.
# Set it in the Vercel project's env vars — it's only needed where the crons run
# (production).
CRON_SECRET=

# mobile.bg import API — the publish desk at /admin/mobile-bg. The account must
# first be authorised for import by mobile.bg (and the photo domain registered).
# Unset ⇒ every advert is computed and previewed but nothing is sent — the normal
# state on a dev machine.
MOBILEBG_USERNAME=
MOBILEBG_PASSWORD=

# Private document storage (S3) for the contracts module: generated PDFs and
# uploaded proofs of payment. The bucket and the least-privilege IAM user come
# from infra (infra/src/storage.ts). Explicit SA_* names because Vercel reserves
# the AWS_* ones. Unset ⇒ nothing is archived and PDFs render on demand from
# their frozen snapshots.
SA_AWS_REGION=
SA_DOCUMENTS_BUCKET=
SA_AWS_ACCESS_KEY_ID=
SA_AWS_SECRET_ACCESS_KEY=

# Google Places API (New) — powers the /otzivi reviews page (rating + up to 5
# reviews, pulled live and cached daily). Both are OPTIONAL: without them the page
# renders a graceful fallback (link to the Google profile) instead of live reviews.
# GOOGLE_PLACES_API_KEY: a Google Cloud key with the Places API enabled + billing
#   (the `reviews` field is Google's Enterprise+Atmosphere SKU — daily caching keeps
#   it to ~1 call/day). Restrict the key to the Places API.
# GOOGLE_PLACES_ID: the business Place ID (e.g. from the Place ID Finder).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=
